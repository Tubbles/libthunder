package mpq

// MPQ adaptive Huffman decompression (compression mask bit 0x01), ported
// from StormLib's huff.cpp / huff.h (the Fahler-Gallager-Knuth variant
// used by Storm.dll). The compressed stream is:
//
//   1. One type byte selecting a built-in weight table (0-8). Read
//      byte-aligned as the very first 8 bits of the stream.
//   2. An LSB-first bit stream (each byte's bit 0 consumed first) of
//      Huffman codes, walked against a tree seeded from that weight
//      table and adapted as symbols are decoded.
//
// Two symbol values are reserved above the 0-255 byte range:
//   0x100  end of stream (decoding stops here, whatever bytes remain
//          undecoded in the last partial byte are not meaningful).
//   0x101  escape ("Not Yet Transmitted" in the reference source): the
//          next 8 bits, read byte-aligned from the bit stream, are a
//          literal byte value that has not appeared before in this
//          stream. The tree grows a new branch for it on the spot.
//
// This port intentionally omits StormLib's "quick link" cache, an
// optimization that memoizes up to 7 bits of recent tree-walk state to
// skip redundant traversal. It only affects decode speed, never the
// decoded bytes: the plain bit-by-bit tree walk below produces identical
// output. MPQ sectors are at most a few KB, so the speed difference is
// not worth the extra state.
//
// Weight-adaptation quirk (verified against huff.cpp, preserved exactly
// for parity with real archives): only table 0 (the "sparse" table)
// re-weights a symbol's tree node on every occurrence. Every other table
// only updates weights the first time a byte value appears, via the
// escape path; once a byte has a tree slot, decoding it again never
// changes the tree. This looks like it defeats "adaptive" for repeated
// bytes, but it is what the reference implementation does, and archives
// produced by the real compressor depend on it for their bit layout.
//
// Also preserved: whether re-weighting is enabled compares the FULL,
// unmasked type byte to zero, while table selection masks the byte to
// its low nibble first. A type byte of 0x10 therefore selects the same
// weight table as 0x00 but does NOT enable per-symbol re-weighting
// (0x10 != 0x00). The documented type byte range is 0-8, so this only
// matters for out-of-spec input, but it is what the reference does.

HUFFMAN_ITEM_POOL_SIZE :: 515
HUFFMAN_BYTE_ITEM_COUNT :: 258
HUFFMAN_END_OF_STREAM :: 0x100
HUFFMAN_ESCAPE_SYMBOL :: 0x101

// LSB-first bit reader: within each byte, bit 0 (0x01) is consumed
// before bit 1 (0x02), and so on, matching TInputStream in huff.cpp.
Huffman_Input_Stream :: struct {
	data:       []u8,
	position:   int,
	bit_buffer: u32,
	bit_count:  u32,
}

huffman_input_get_1_bit :: proc(stream: ^Huffman_Input_Stream) -> (bit: u32, ok: bool) {
	if stream.bit_count == 0 {
		if stream.position >= len(stream.data) {
			return 0, false
		}
		stream.bit_buffer = u32(stream.data[stream.position])
		stream.position += 1
		stream.bit_count = 8
	}

	bit = stream.bit_buffer & 0x01
	stream.bit_buffer >>= 1
	stream.bit_count -= 1
	return bit, true
}

huffman_input_get_8_bits :: proc(stream: ^Huffman_Input_Stream) -> (value: u32, ok: bool) {
	if stream.bit_count < 8 {
		if stream.position >= len(stream.data) {
			return 0, false
		}
		reload_byte := u32(stream.data[stream.position])
		stream.position += 1
		stream.bit_buffer |= reload_byte << stream.bit_count
		stream.bit_count += 8
	}

	value = stream.bit_buffer & 0xFF
	stream.bit_buffer >>= 8
	stream.bit_count -= 8
	return value, true
}

// One node of the adaptive Huffman tree. All nodes (leaves and internal
// branches alike) live in a single doubly-linked list ordered by weight,
// descending from `next` (highest weight) to `prev` (lowest weight);
// this list doubles as the priority structure used to build and
// rebalance the tree. A node's sibling is always its `child_lo`'s `prev`
// neighbor in that list: the FGK algorithm's invariant is that siblings
// stay list-adjacent, with `child_lo` naming whichever one has the lower
// weight.
Huffman_Tree_Item :: struct {
	next:               ^Huffman_Tree_Item,
	prev:               ^Huffman_Tree_Item,
	decompressed_value: u32,
	weight:             u32,
	parent:             ^Huffman_Tree_Item,
	child_lo:           ^Huffman_Tree_Item,
}

Huffman_Insert_Point :: enum {
	After,
	Before,
}

Huffman_Tree :: struct {
	item_buffer:    [HUFFMAN_ITEM_POOL_SIZE]Huffman_Tree_Item,
	items_used:     int,
	list_head:      Huffman_Tree_Item, // Sentinel; list_head.next/.prev are the highest/lowest weight items.
	items_by_byte:  [HUFFMAN_BYTE_ITEM_COUNT]^Huffman_Tree_Item,
	is_sparse_data: bool,
}

huffman_link_two_items :: proc(item1: ^Huffman_Tree_Item, item2: ^Huffman_Tree_Item) {
	item2.next = item1.next
	item2.prev = item1
	item1.next.prev = item2
	item1.next = item2
}

huffman_remove_item :: proc(item: ^Huffman_Tree_Item) {
	if item.next != nil {
		item.prev.next = item.next
		item.next.prev = item.prev
		item.next = nil
		item.prev = nil
	}
}

huffman_insert_item :: proc(tree: ^Huffman_Tree, new_item: ^Huffman_Tree_Item, insert_point: Huffman_Insert_Point) {
	huffman_remove_item(new_item)

	switch insert_point {
	case .After:
		huffman_link_two_items(&tree.list_head, new_item)
	case .Before:
		huffman_link_two_items(tree.list_head.prev, new_item)
	}
}

huffman_create_new_item :: proc(tree: ^Huffman_Tree, decompressed_value: u32, weight: u32, insert_point: Huffman_Insert_Point) -> ^Huffman_Tree_Item {
	if tree.items_used >= HUFFMAN_ITEM_POOL_SIZE {
		return nil
	}

	new_item := &tree.item_buffer[tree.items_used]
	tree.items_used += 1

	huffman_insert_item(tree, new_item, insert_point)

	new_item.decompressed_value = decompressed_value
	new_item.weight = weight
	new_item.parent = nil
	new_item.child_lo = nil

	return new_item
}

// Walks from `start_item` toward higher weight (via `prev`) looking for
// the first item whose weight is already >= `weight`. Returns the list
// sentinel if none is found, meaning "insert at the very front".
huffman_find_higher_or_equal_item :: proc(tree: ^Huffman_Tree, start_item: ^Huffman_Tree_Item, weight: u32) -> ^Huffman_Tree_Item {
	item := start_item
	for item != &tree.list_head {
		if item.weight >= weight {
			return item
		}
		item = item.prev
	}
	return &tree.list_head
}

huffman_fixup_item_pos_by_weight :: proc(tree: ^Huffman_Tree, new_item: ^Huffman_Tree_Item, max_weight: u32) -> u32 {
	if new_item.weight < max_weight {
		higher_item := huffman_find_higher_or_equal_item(tree, tree.list_head.prev, new_item.weight)
		huffman_remove_item(new_item)
		huffman_link_two_items(higher_item, new_item)
		return max_weight
	}
	return new_item.weight
}

// Builds the tree from one of the nine built-in weight tables. `type_byte`
// is the raw, unmasked byte read from the stream: table selection uses
// its low nibble, but the sparse re-weighting flag compares the full
// byte to zero (see the file header comment).
huffman_build_tree :: proc(tree: ^Huffman_Tree, type_byte: u32) -> bool {
	tree.list_head = Huffman_Tree_Item{}
	tree.list_head.next = &tree.list_head
	tree.list_head.prev = &tree.list_head
	tree.items_used = 0
	for index in 0 ..< HUFFMAN_BYTE_ITEM_COUNT {
		tree.items_by_byte[index] = nil
	}
	tree.is_sparse_data = (type_byte == 0)

	table_index := int(type_byte & 0x0F)
	if table_index >= len(HUFFMAN_DATA_DISTRIBUTIONS) {
		return false
	}
	distribution := HUFFMAN_DATA_DISTRIBUTIONS[table_index]

	max_weight: u32 = 0
	for byte_value in 0 ..< 256 {
		weight := u32(distribution[byte_value])
		if weight == 0 {
			continue
		}

		item := huffman_create_new_item(tree, u32(byte_value), weight, .After)
		if item == nil {
			return false
		}
		tree.items_by_byte[byte_value] = item
		max_weight = huffman_fixup_item_pos_by_weight(tree, item, max_weight)
	}

	end_of_stream_item := huffman_create_new_item(tree, HUFFMAN_END_OF_STREAM, 1, .Before)
	if end_of_stream_item == nil {
		return false
	}
	tree.items_by_byte[HUFFMAN_END_OF_STREAM] = end_of_stream_item

	escape_item := huffman_create_new_item(tree, HUFFMAN_ESCAPE_SYMBOL, 1, .Before)
	if escape_item == nil {
		return false
	}
	tree.items_by_byte[HUFFMAN_ESCAPE_SYMBOL] = escape_item

	// Pair off the two lowest-weight items repeatedly, growing the tree
	// bottom-up. The freshly created parent is reinserted into the same
	// weight-ordered list, so the next pairing again picks the two
	// lowest-weight items overall (leaves or earlier internal nodes).
	child_lo := tree.list_head.prev
	for child_lo != &tree.list_head {
		child_hi := child_lo.prev
		if child_hi == &tree.list_head {
			break
		}

		new_item := huffman_create_new_item(tree, 0, child_hi.weight + child_lo.weight, .After)
		if new_item == nil {
			return false
		}

		child_lo.parent = new_item
		child_hi.parent = new_item
		new_item.child_lo = child_lo

		max_weight = huffman_fixup_item_pos_by_weight(tree, new_item, max_weight)

		child_lo = child_hi.prev
	}

	return true
}

// Climbs from `start_item` to the tree root, incrementing each ancestor's
// weight by one and swapping it past any earlier-positioned item of
// equal or greater weight to keep the list (and therefore the tree)
// correctly ordered by weight.
huffman_inc_weights_and_rebalance :: proc(tree: ^Huffman_Tree, start_item: ^Huffman_Tree_Item) {
	item := start_item

	for item != nil {
		item.weight += 1

		higher_item := huffman_find_higher_or_equal_item(tree, item.prev, item.weight)
		higher_weight_child := higher_item.next

		if higher_weight_child != item {
			huffman_remove_item(higher_weight_child)
			huffman_link_two_items(item, higher_weight_child)

			huffman_remove_item(item)
			huffman_link_two_items(higher_item, item)

			// item and higher_weight_child are swapping places in the
			// tree, not just the list; re-point their respective
			// parents' child_lo and their own parent pointers to match.
			lower_weight_sibling := higher_weight_child.parent.child_lo
			parent := item.parent

			if parent.child_lo == item {
				parent.child_lo = higher_weight_child
			}
			if lower_weight_sibling == higher_weight_child {
				higher_weight_child.parent.child_lo = item
			}

			item.parent = higher_weight_child.parent
			higher_weight_child.parent = parent
		}

		item = item.parent
	}
}

// Handles the escape symbol: the list's current lowest-weight item
// (holding `value1`, normally the escape symbol itself) becomes an
// internal branch with two new leaf children, `value1` (keeping the old
// weight) and `value2` (the newly seen byte, starting at weight 0 before
// huffman_inc_weights_and_rebalance below brings it to 1).
huffman_insert_new_branch_and_rebalance :: proc(tree: ^Huffman_Tree, value1: u32, value2: u32) -> bool {
	last_item := tree.list_head.prev

	higher_child := huffman_create_new_item(tree, value1, last_item.weight, .Before)
	if higher_child == nil {
		return false
	}
	higher_child.parent = last_item
	tree.items_by_byte[value1] = higher_child

	lower_child := huffman_create_new_item(tree, value2, 0, .Before)
	if lower_child == nil {
		return false
	}
	lower_child.parent = last_item
	last_item.child_lo = lower_child
	tree.items_by_byte[value2] = lower_child

	huffman_inc_weights_and_rebalance(tree, lower_child)
	return true
}

huffman_decode_one_byte :: proc(tree: ^Huffman_Tree, input: ^Huffman_Input_Stream) -> (value: u32, ok: bool) {
	if tree.list_head.next == &tree.list_head {
		return 0, false
	}

	item := tree.list_head.next
	for item.child_lo != nil {
		bit_value, bit_ok := huffman_input_get_1_bit(input)
		if !bit_ok {
			return 0, false
		}
		item = item.child_lo.prev if bit_value == 1 else item.child_lo
	}

	return item.decompressed_value, true
}

huffman_decompress :: proc(compressed_data: []u8, expected_size: int, allocator := context.allocator) -> (decompressed_data: []u8, error: Decompress_Error) {
	if len(compressed_data) == 0 {
		return nil, .Corrupt_Data
	}

	input := Huffman_Input_Stream{data = compressed_data}

	type_byte, type_byte_ok := huffman_input_get_8_bits(&input)
	if !type_byte_ok {
		return nil, .Corrupt_Data
	}

	tree: Huffman_Tree
	if !huffman_build_tree(&tree, type_byte) {
		return nil, .Corrupt_Data
	}

	output := make([dynamic]u8, 0, expected_size, allocator)

	for {
		decoded_value, decode_ok := huffman_decode_one_byte(&tree, &input)
		if !decode_ok {
			delete(output)
			return nil, .Corrupt_Data
		}
		if decoded_value == HUFFMAN_END_OF_STREAM {
			break
		}

		if decoded_value == HUFFMAN_ESCAPE_SYMBOL {
			literal_byte, literal_ok := huffman_input_get_8_bits(&input)
			if !literal_ok {
				delete(output)
				return nil, .Corrupt_Data
			}

			escape_value := tree.list_head.prev.decompressed_value
			if !huffman_insert_new_branch_and_rebalance(&tree, escape_value, literal_byte) {
				delete(output)
				return nil, .Corrupt_Data
			}
			decoded_value = literal_byte

			if !tree.is_sparse_data {
				huffman_inc_weights_and_rebalance(&tree, tree.items_by_byte[int(decoded_value)])
			}
		}

		if len(output) >= expected_size {
			delete(output)
			return nil, .Output_Size_Mismatch
		}
		append(&output, u8(decoded_value))

		if tree.is_sparse_data {
			huffman_inc_weights_and_rebalance(&tree, tree.items_by_byte[int(decoded_value)])
		}
	}

	return output[:], .None
}

// Byte-to-weight tables for the nine built-in compression types (0-8),
// transcribed verbatim from huff.cpp's DataDistribution_* arrays. Each
// table declares 258 entries (matching BYTE_ITEM_COUNT in the reference)
// but huffman_build_tree only ever reads indices 0..255; the trailing 2
// bytes are transcribed for fidelity and otherwise unused.

