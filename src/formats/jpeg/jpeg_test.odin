@(test)
solid_color_four_component_decodes_exactly :: proc(t: ^testing.T) {
	result, error := decode_component_planes(solid_cmyk_jpeg[:])
	defer destroy(&result)
	testing.expect_value(t, error, Error.None)
	testing.expect_value(t, result.width, 16)
	testing.expect_value(t, result.height, 16)
	testing.expect_value(t, result.component_count, 4)

	expected := [4]u8{235, 175, 105, 55}
	for component_index in 0..<4 {
		for pixel_index in 0..<16 * 16 {
			testing.expect_value(t, result.planes[component_index][pixel_index], expected[component_index])
		}
	}
}

@(test)
gradient_four_component_decodes_within_tolerance :: proc(t: ^testing.T) {
	result, error := decode_component_planes(gradient_cmyk_jpeg[:])
	defer destroy(&result)
	testing.expect_value(t, error, Error.None)
	testing.expect_value(t, result.width, 16)
	testing.expect_value(t, result.height, 16)
	testing.expect_value(t, result.component_count, 4)

	for sample in gradient_reference {
		expected := [4]u8{sample.cyan, sample.magenta, sample.yellow, sample.key}
		for component_index in 0..<4 {
			actual := int(result.planes[component_index][sample.pixel_index])
			difference := abs(actual - int(expected[component_index]))
			testing.expectf(
				t, difference <= 2,
				"pixel %d component %d: got %d, want %d +/-2",
				sample.pixel_index, component_index, actual, expected[component_index],
			)
		}
	}
}

@(test)
non_multiple_of_eight_dimensions_clip_correctly :: proc(t: ^testing.T) {
	result, error := decode_component_planes(clipped_gray_jpeg[:])
	defer destroy(&result)
	testing.expect_value(t, error, Error.None)
	testing.expect_value(t, result.width, 20)
	testing.expect_value(t, result.height, 12)
	testing.expect_value(t, result.component_count, 1)

	for y in 0..<12 {
		for x in 0..<20 {
			expected := u8(50 + 30 * (x / 8) + 5 * (y / 8))
			testing.expect_value(t, result.planes[0][y * 20 + x], expected)
		}
	}
}

@(test)
grayscale_one_component_decodes_exactly :: proc(t: ^testing.T) {
	result, error := decode_component_planes(solid_gray_jpeg[:])
	defer destroy(&result)
	testing.expect_value(t, error, Error.None)
	testing.expect_value(t, result.width, 16)
	testing.expect_value(t, result.height, 16)
	testing.expect_value(t, result.component_count, 1)

	for pixel_index in 0..<16 * 16 {
		testing.expect_value(t, result.planes[0][pixel_index], u8(77))
	}
}

@(test)
rgb_three_component_decodes_plausibly :: proc(t: ^testing.T) {
	result, error := decode_component_planes(solid_rgb_jpeg[:])
	defer destroy(&result)
	testing.expect_value(t, error, Error.None)
	testing.expect_value(t, result.width, 16)
	testing.expect_value(t, result.height, 16)
	testing.expect_value(t, result.component_count, 3)

	expected := [3]int{98, 89, 200} // hand-computed Y, Cb, Cr; see comment above the fixture
	for component_index in 0..<3 {
		actual := int(result.planes[component_index][0])
		difference := abs(actual - expected[component_index])
		testing.expectf(
			t, difference <= 5,
			"component %d: got %d, want %d +/-5", component_index, actual, expected[component_index],
		)
	}
}

@(test)
restart_markers_reset_dc_predictor_correctly :: proc(t: ^testing.T) {
	result, error := decode_component_planes(restart_gray_jpeg[:])
	defer destroy(&result)
	testing.expect_value(t, error, Error.None)
	testing.expect_value(t, result.width, 32)
	testing.expect_value(t, result.height, 32)
	testing.expect_value(t, result.component_count, 1)

	for y in 0..<32 {
		for x in 0..<32 {
			expected := u8((50 + 10 * ((x / 8) + (y / 8) * 4)) % 256)
			testing.expect_value(t, result.planes[0][y * 32 + x], expected)
		}
	}
}

@(test)
truncated_stream_is_corrupt :: proc(t: ^testing.T) {
	truncated := solid_cmyk_jpeg[:len(solid_cmyk_jpeg) - 20]
	result, error := decode_component_planes(truncated)
	defer destroy(&result)
	testing.expect_value(t, error, Error.Corrupt_Stream)
}

@(test)
progressive_jpeg_is_unsupported :: proc(t: ^testing.T) {
	result, error := decode_component_planes(progressive_jpeg[:])
	defer destroy(&result)
	testing.expect_value(t, error, Error.Unsupported_Feature)
}
